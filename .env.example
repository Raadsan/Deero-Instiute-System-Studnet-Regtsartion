# Database and authentication
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sodma"
JWT_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# Hormuud SMS credentials from https://business.hormuud.com/
# Use the API username and API PASSWORD from your Hormuud business profile.
SMS_HORMUUD_USERNAME=""
SMS_HORMUUD_PASSWORD=""
# Approved sender/display name. Hormuud requires this value.
SMS_HORMUUD_SENDER_ID=""

# Optional messaging providers
WHATSAPP_PROVIDER="meta"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Deero Institute <noreply@example.com>"
